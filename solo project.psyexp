    <LoopInitiator loopType="TrialHandler" name="logoloop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'brandlogo': 'images/district.png'}, {'brandlogo': 'images/alibaba.png'}, {'brandlogo': 'images/dropbox.png'}, {'brandlogo': 'images/barbie.png'}, {'brandlogo': 'images/hilton.jpg'}, {'brandlogo': 'images/Starbucks.png'}, {'brandlogo': 'images/nike.jpeg'}, {'brandlogo': 'images/ups.png'}, {'brandlogo': 'images/icici.jpeg'}, {'brandlogo': 'images/motherdairy.png'}, {'brandlogo': 'images/snapchat.jpeg'}, {'brandlogo': 'images/coca cola.png'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.solo.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
