      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="logoloop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="logo_routine"/>
    <LoopTerminator name="logoloop"/>
    <LoopInitiator loopType="TrialHandler" name="colorloop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'color': 'images1/pink'}, {'color': 'images1/black'}, {'color': 'images1/purple'}, {'color': 'images1/green'}, {'color': 'images1/light blue'}, {'color': 'images1/orangered'}, {'color': 'images1/red'}, {'color': 'images1/yellow'}, {'color': 'images1/blue'}, {'color': 'images1/orange'}, {'color': 'images1/blackgold'}, {'color': 'images1/dark blue'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="color.conditions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="fullRandom" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="colorloop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="colorlogo"/>
    <LoopTerminator name="colorloop"/>
  </Flow>
